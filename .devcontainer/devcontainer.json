{
    "name": "torch-mlir",

    "build": {
        "dockerfile": "../build_tools/docker/Dockerfile",
        "context": ".."
    },

    "workspaceFolder": "/workspace/torch-mlir",

    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace/torch-mlir,type=bind",
        "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached"
    ],

    "runArgs": [
        "--init",
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined"
    ],

    "remoteUser": "root",

    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "llvm-vs-code-extensions.vscode-mlir",
                "llvm-vs-code-extensions.vscode-lldb",

                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",

                "matepek.vscode-catch2-test-adapter",

                "eamodio.gitlens",
                "EditorConfig.EditorConfig",
                
                "Anthropic.claude-code"
            ],

            "settings": {
                "editor.formatOnSave": true,

                "[c]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
                },

                "[cpp]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
                },

                "C_Cpp.intelliSenseEngine": "disabled",

                "clangd.arguments": [
                    "--background-index",
                    "--clang-tidy",
                    "--completion-style=detailed",
                    "--header-insertion=iwyu",
                    "--cross-file-rename",
                    "--pch-storage=memory"
                ],

                "cmake.generator": "Ninja",
                "cmake.configureOnOpen": true,
                "cmake.buildDirectory": "${workspaceFolder}/build",

                "cmake.configureSettings": {
                    "CMAKE_BUILD_TYPE": "Debug",
                    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
                },

                "cmake.debugConfig": {
                    "type": "lldb-dap"
                },

                "testMate.cpp.debug.configTemplate": {
                    "type": "lldb-dap",
                    "program": "${exec}",
                    "args": "${argsArray}",
                    "cwd": "${cwd}",
                    "env": "${envObj}",
                    "sourceFileMap": "${sourceFileMapObj}"
                },

                "files.associations": {
                    "*.td": "tablegen"
                },

                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
